## IGNORE
# Subdirectories
*/
# Symbolic links

# Secrets and Password files 
/*.env
/*.gen
*secrets*.*
# Hidden files
/.*

# Files
/*.log*
/*.db*
/*.conf*
/go2rtc*
/*.conf
/*.txt
# PDFs: large binaries, and documents (offers, drawings) do not belong in the config repo
/*.pdf

## INCLUDE
# Gitignore file
!/.gitignore

# Track ordinary Home Assistant helper scripts. Keep credentials and key material out even when
# they are placed under this directory in the future.
!scripts/
!scripts/**
scripts/**/*.env
scripts/**/*.key
scripts/**/*.pem
scripts/**/*secret*
scripts/**/*token*
